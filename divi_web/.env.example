# API URL output by Terraform. No trailing slash.
VITE_API_URL=https://your-api-id.execute-api.us-east-2.amazonaws.com
# Set after Cognito is provisioned. The frontend uses Hosted UI + PKCE and
# sends its ID token as Bearer to the API.
VITE_COGNITO_DOMAIN=https://your-cognito-prefix.auth.us-east-2.amazoncognito.com
VITE_COGNITO_CLIENT_ID=your-cognito-client-id
